  <!-- BOOKING MODAL -->
  <div class="modal-overlay" id="bookingModal" onclick="closeModalOnBackdrop(event)">
    <div class="modal-box">
      <button class="modal-close" onclick="closeBookingModal()" aria-label="Đóng cửa sổ đặt lịch">&times;</button>
      <h3 class="modal-title">Đặt Lịch Hẹn</h3>
      <p style="text-align: center; color: var(--text-muted); margin-bottom: 25px; font-size: 0.9rem;">
        Quý khách vui lòng để lại thông tin, Mingo Spa sẽ liên hệ xác nhận trong vòng 5 phút!
      </p>

      <form id="bookingForm" onsubmit="handleBookingSubmit(event)">
        <div class="form-group">
          <label for="custName">Họ và Tên của Bạn *</label>
          <input type="text" id="custName" class="form-control" placeholder="Ví dụ: Nguyễn Thùy Dung" required>
        </div>

        <div class="form-group">
          <label for="custPhone">Số Điện Thoại Nhận Tin Nhắn *</label>
          <input type="tel" id="custPhone" class="form-control" placeholder="Ví dụ: 0909 000 123" required>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="bookDate">Ngày Hẹn</label>
            <input type="date" id="bookDate" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="bookTime">Giờ Dự Kiến</label>
            <input type="time" id="bookTime" class="form-control" required>
          </div>
        </div>

        <div class="form-group">
          <label for="serviceSelect">Dịch Vụ Bạn Quan Tâm</label>
          <select id="serviceSelect" class="form-control">
            <option value="Combo 1 - 325K">Combo 1 (Gội Chuyên Sâu + Cổ Vai Gáy - 325K)</option>
            <option value="Combo 2 - 395K" selected>Combo 2 (Xông Hơi + Body 60' - 395K)</option>
            <option value="Combo 3 - 395K">Combo 3 (Gội Đầu + Body 60' - 395K)</option>
            <option value="Combo 4 - 495K">Combo 4 (Gội Chuyên Sâu + Body 60' - 495K)</option>
            <option value="Combo 5 - 495K">Combo 5 (Gội Đầu + Massage 90' - 495K)</option>
            <option value="Combo 6 - 545K">Combo 6 (Gói VIP Toàn Diện 90' - 545K)</option>
            <option value="Gội Đầu Hàn Quốc">Gội Đầu Hàn Quốc</option>
            <option value="Massage Cổ Vai Gáy">Massage Trị Liệu Cổ Vai Gáy</option>
            <option value="Massage Body Thụy Điển/Thái">Massage Thụy Điển / Massage Thái</option>
            <option value="Ngâm Bồn Thuốc Dao Đỏ">Ngâm Bồn Gỗ Thuốc Dao Đỏ</option>
          </select>
        </div>

        <div class="form-group">
          <label for="roomReq">Yêu Cầu Phòng</label>
          <select id="roomReq" class="form-control">
            <option value="Phòng Tiêu Chuẩn">Phòng Thư Giãn Tiêu Chuẩn</option>
            <option value="Phòng Cặp Đôi (+49K)">Phòng Riêng Cặp Đôi (+49K)</option>
            <option value="Phòng VIP Đơn (+49K)">Phòng Riêng VIP Cá Nhân (+49K)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
          Xác Nhận Đặt Lịch Qua Zalo
        </button>
      </form>
    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // 1. Mobile Menu Toggle
    const mobileToggle = document.getElementById('mobileToggle');
    const navLinks = document.getElementById('navLinks');

    mobileToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });

    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('active');
      });
    });

    // 2. Menu Tabs Navigation
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.menu-group').forEach(group => group.classList.remove('active'));

      event.target.classList.add('active');
      const targetGroup = document.getElementById(tabId);
      if (targetGroup) {
        targetGroup.classList.add('active');
      }
    }

    // 3. Modal Booking Management
    const bookingModal = document.getElementById('bookingModal');
    const serviceSelect = document.getElementById('serviceSelect');

    function openBookingModal() {
      bookingModal.classList.add('active');
      // Tự động set ngày hẹn mặc định là hôm nay
      const today = new Date().toISOString().split('T')[0];
      const dateInput = document.getElementById('bookDate');
      if (dateInput && !dateInput.value) {
        dateInput.value = today;
      }
    }

    function closeBookingModal() {
      bookingModal.classList.remove('active');
    }

    function closeModalOnBackdrop(e) {
      if (e.target === bookingModal) {
        closeBookingModal();
      }
    }

    function selectCombo(comboName) {
      if (serviceSelect) {
        serviceSelect.value = comboName;
      }
      openBookingModal();
    }

    // 4. Form Submission & Chuyển Hướng Gửi Tin Nhắn Zalo
    function handleBookingSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('custName').value;
      const phone = document.getElementById('custPhone').value;
      const date = document.getElementById('bookDate').value;
      const time = document.getElementById('bookTime').value;
      const service = document.getElementById('serviceSelect').value;
      const room = document.getElementById('roomReq').value;

      // Nội dung tin nhắn đặt lịch sẵn
      const message = `Xin chào Mingo Spa, tôi muốn đặt lịch hẹn:\n- Tên: ${name}\n- SĐT: ${phone}\n- Dịch vụ: ${service}\n- Loại phòng: ${room}\n- Thời gian: ${time} ngày ${date}`;
      
      // Mở Zalo hotline của Mingo Spa (hoặc gọi điện)
      const encodedMsg = encodeURIComponent(message);
      alert('Cảm ơn quý khách ' + name + '! Hệ thống đang chuyển thông tin đặt lịch đến chuyên viên lễ tân Mingo Spa qua Zalo.');
      
      // Mở cửa sổ Zalo chat
      window.open(`https://zalo.me/0583830123?text=${encodedMsg}`, '_blank');
      closeBookingModal();
    }
  </script>
</body>
</html>
